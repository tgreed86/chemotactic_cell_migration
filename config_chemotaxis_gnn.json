{
  "data": "data/unique_meshes/chemotaxis_varying-Chi_flux_64x64.npz",
  "output": "runs/multi-step/fluxgraphnet/with_advection/test",
  "model": "fluxgraphnet",
  "target_type": "delta",
    "physics_inputs": {
    "enabled": true,
    "include_adv": true,
    "input_form": "delta",
    "advection_scheme": "upwind",
    "adv_all_steps": true,
    "input_weighted": false,
    "adv_weight": 1.0,
    "normalize_adv_to_minus1_1": false,
    "adv_min": null,
    "adv_max": null,
    "normalize_adv_clip": false,
    "detach_inputs": true
  },
  "decode_normalized_flux": true,
  "node_loss_normalization": "target",
  "node_density_weighting": "target",
  "node_density_weight_strength": 0.25,
  "flux_decoder_edge_features": "processed",
  "antisymmetric_flux_decoder": true,
  "autoregressive_steps": 5,
  "mass_projection": false,
  "epochs": 10,
  "batch_size": 16,
  "learning_rate": 1e-5,
  "weight_decay": 1e-05,
  "node_weight_loss": 1.0,
  "node_loss_normalization": "target",
  "flux_loss_weight": 10.0,
  "flux_supervision_steps": "first",
  "gradient_clip_norm": 1.0,
  "hidden_channels": 128,
  "num_layers": 4,
  "dropout": 0.1,
  "layer_norm": false,
  "include_chi": false,
  "include_drift_velocity": true,
  "include_absolute_positions": true,
  "include_boundary_distances": false,
  "train_fraction": 0.8,
  "validation_fraction": 0.1,
  "test_fraction": 0.1,
  "patience": 0,
  "seed": 1234,
  "device": "mps",
  "num_workers": 0,
  "log_every": 10
}
